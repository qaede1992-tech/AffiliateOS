API_HOST=127.0.0.1
API_PORT=3001
API_CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
DATABASE_URL=postgresql://affiliateos:affiliateos@localhost:5432/affiliateos
# Required in production; keep the real value in a secret manager.
API_AUTH_TOKEN=
API_AUTH_OPERATOR_ID=operator-1
API_AUTH_OPERATOR_ROLE=admin
# Production defaults: 120 application requests per client IP per 60 seconds.
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
# Autonomous marketplace-to-campaign execution is opt-in until real providers are configured.
AUTONOMOUS_CYCLE_ENABLED=false
# Minimum supported interval is 5 minutes; default is 15 minutes.
AUTONOMOUS_CYCLE_INTERVAL_MS=900000

# Autonomous opportunity selection policy
AUTONOMOUS_MINIMUM_SCORE=60
AUTONOMOUS_MAXIMUM_RESULTS=10
AUTONOMOUS_MINIMUM_COMMISSION_BPS=0
AUTONOMOUS_MINIMUM_COMMISSION_AMOUNT_CENTS=0
AUTONOMOUS_MINIMUM_DEMAND_SCORE=0

# Optional per-marketplace autonomous policy overrides. Keys are marketplace connection IDs.
AUTONOMOUS_MARKETPLACE_POLICIES_JSON={}

AUTONOMOUS_OPTIMIZATION_MIN_COMMISSION_PER_CLICK_CENTS=0

# Shopee Affiliate runtime configuration. Keep app ID/secret in the deployment secret manager; the credential reference is safe metadata.
SHOPEE_AFFILIATE_CREDENTIAL_REFERENCE=secret://affiliateos/shopee/production
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=
SHOPEE_AFFILIATE_MARKET=ID
SHOPEE_AFFILIATE_API_VERSION=v2
# Shopee conversion report sync is disabled until provider credentials and attribution are validated end-to-end.
SHOPEE_CONVERSION_SYNC_ENABLED=false
# Minimum supported interval is 5 minutes; default is 15 minutes.
SHOPEE_CONVERSION_SYNC_INTERVAL_MS=900000
# Reconcile a rolling window so late provider status changes are picked up; max 31 days.
SHOPEE_CONVERSION_SYNC_LOOKBACK_HOURS=192
# Official social OAuth app credentials. Leave empty until the provider apps and redirect URIs are approved/configured.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
