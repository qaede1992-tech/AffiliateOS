{
  "name": "@affiliateos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
   "dev": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate",
    "start": "node --env-file=../../.env dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@affiliateos/shared": "0.1.0",
    "@fastify/cors": "^11.1.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5"
  },
  "drizzle": {
    "config": "drizzle.config.ts"
  }
}
